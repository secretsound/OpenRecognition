# syntax=docker/dockerfile:1

# Build Vue admin UI
FROM node:22-alpine AS web-builder
WORKDIR /build
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY src/web/ ./
RUN npm run build

# Static ffmpeg/ffprobe. Debian's ffmpeg package installs ~190 libraries
# (LLVM, Mesa, SDL, X11): a slow unpack under emulation and about 400MB.
FROM mwader/static-ffmpeg:8.1.1 AS ffmpeg

# Python API + static UI
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg /ffprobe /usr/local/bin/ffprobe

WORKDIR /app

# Third-party wheels only. A later source edit must not reinstall them.
COPY pyproject.toml ./
RUN --mount=type=bind,from=ghcr.io/astral-sh/uv:0.13.5,source=/uv,target=/usr/local/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv pip compile pyproject.toml --only-binary :all: --no-header --output-file /tmp/requirements.txt \
    && UV_LINK_MODE=copy UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1 \
       uv pip install --system --only-binary :all: --requirement /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY README.md ./
COPY src ./src/
RUN --mount=type=bind,from=ghcr.io/astral-sh/uv:0.13.5,source=/uv,target=/usr/local/bin/uv \
    UV_LINK_MODE=copy UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1 \
    uv pip install --system --no-deps . \
    && python -c "import uvicorn, fastapi, onnxruntime; import openrecognition; print('build ok')" \
    && ffmpeg -hide_banner -version \
    && ffprobe -hide_banner -version

COPY --from=web-builder /build/dist ./web/dist/

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV OPENRECOGNITION_HOST=0.0.0.0 \
    OPENRECOGNITION_PORT=8080 \
    OPENRECOGNITION_DATA_DIR=/data \
    OPENRECOGNITION_MODELS_DIR=/models \
    OPENRECOGNITION_MODEL_PACKS_DIR=/models \
    OPENRECOGNITION_WEB_DIST=/app/web/dist

VOLUME /data /models

LABEL org.opencontainers.image.title="OpenRecognition" \
    org.opencontainers.image.description="Self-hosted voice, face, and object recognition. Mount /data and /models. The console listens on port 8080." \
    org.opencontainers.image.source="https://github.com/secretsound/OpenRecognition" \
    org.opencontainers.image.url="https://github.com/secretsound/OpenRecognition" \
    org.opencontainers.image.documentation="https://github.com/secretsound/OpenRecognition/blob/main/docker/README.md" \
    org.opencontainers.image.licenses="Apache-2.0"
# EXPOSE documents ports; publish them at run time (e.g. docker compose ports: 8080, 10301).
EXPOSE 8080 10301/tcp

ENTRYPOINT ["/entrypoint.sh"]
CMD ["openrecognition", "serve"]
