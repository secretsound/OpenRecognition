{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenRecognition: serve (reload)",
      "type": "shell",
      "command": "python -m uvicorn openrecognition.api.app:create_app --factory --host 0.0.0.0 --port 8080 --reload --reload-dir src",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "OpenRecognition: web dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "OpenRecognition: serve",
      "type": "shell",
      "command": "openrecognition serve",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "OpenRecognition: pytest",
      "type": "shell",
      "command": "pytest tests/ -v",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Docker: compose up (production-like)",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
